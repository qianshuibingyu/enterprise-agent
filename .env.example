# PostgreSQL settings (server-side only)
POSTGRES_USER=enterprise_agent
POSTGRES_DB=enterprise_agent
POSTGRES_PASSWORD=

# Canonical HTTPS origin used by backend CSRF/Origin checks.
AUTH_ORIGIN=https://example.invalid

# Project-owned WhatsApp Web + Baileys adapter.
WHATSAPP_ADAPTER_URL=
WHATSAPP_ADAPTER_TOKEN=
WHATSAPP_AUTH_STATE_KEY=
# Required for encrypted durable WhatsApp message queue. Generate/store in server secret manager.
WHATSAPP_INBOX_ENCRYPTION_KEY=
WHATSAPP_CONNECT_TIMEOUT_SECONDS=15
WHATSAPP_SEND_TIMEOUT_SECONDS=15
# Pairing waits for the bridge to produce a QR (bridge deadline ~15s + handshake slack).
WHATSAPP_PAIR_TIMEOUT_SECONDS=30

# Project-owned Gmail Google OAuth/API + Pub/Sub integration.
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_PUBSUB_PROJECT=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
GMAIL_PUBSUB_PUSH_TOKEN=
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
GMAIL_TIMEOUT_SECONDS=20
GMAIL_RECONCILE_INTERVAL_SECONDS=600
GMAIL_USER_ID=me
# Server-only Fernet key for encrypted per-account Gmail refresh tokens.
# Generate/store through a secret manager; never commit a real value.
GMAIL_CREDENTIAL_ENCRYPTION_KEY=

# Microsoft Graph / Entra read-only Outlook integration.
OUTLOOK_ENABLED=false
OUTLOOK_TENANT_ID=
# Use common for apps that allow personal Outlook accounts.
OUTLOOK_AUTHORITY=common
OUTLOOK_CLIENT_ID=
# Server secret only; never commit a real value.
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=
OUTLOOK_SCOPES=openid profile email offline_access User.Read Mail.Read
OUTLOOK_TIMEOUT_SECONDS=8
# Server-only Fernet key for encrypted per-account Outlook refresh tokens.
OUTLOOK_CREDENTIAL_ENCRYPTION_KEY=

# Optional dedicated egress proxy for provider calls (Gmail / Microsoft Graph).
# Leave empty to reach providers directly (outbound 443 must be allowed).
# Set it when the server can reach the WhatsApp bridge but not Google/Microsoft;
# the 「回源自检」diagnostic reports the failing host and transport reason.
PROVIDER_HTTPS_PROXY=
PROVIDER_HTTP_PROXY=

# Legacy external MCP settings are unused by the direct Graph path.
# This file must contain placeholders only. Copy it to .env and fill real
# values there; never commit tenant IDs, client IDs, secrets or tokens.

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8